# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# SOURCE_DIR - Directory to watch for incoming audiobooks (default: /data/incoming)
SOURCE_DIR=/data/incoming

# DEST_DIR - Target library directory for organized files (default: /data/library)  
DEST_DIR=/data/library

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# LOG_FILE - Path to persistent log file (default: /data/logs/migrations.log)
LOG_FILE=/data/logs/migrations.log

# LOG_LEVEL - Logging level: trace, debug, info, warn, error (default: info)
LOG_LEVEL=info

# =============================================================================
# OPTIONAL AI CONFIGURATION
# =============================================================================

# Default provider is anthropic. No native key means heuristic-only operation.
# Supported: anthropic, openai, google, openai-compatible
AI_PROVIDER=anthropic
# Anthropic model: AI_MODEL > CLAUDE_MODEL > claude-haiku-5-5
# Other providers require an explicit nonblank AI_MODEL.
# AI_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-example

# OpenAI example (uncomment this block instead of the selection above):
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=your-openai-key

# Google Gemini example:
# AI_PROVIDER=google
# AI_MODEL=gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-key

# Local OpenAI-compatible endpoint without authentication:
# AI_PROVIDER=openai-compatible
# AI_MODEL=local-model
# AI_BASE_URL=http://localhost:1234/v1
# Authenticated compatible example:
# AI_MODEL=hosted-model
# AI_BASE_URL=https://inference.example.com/v1
# AI_API_KEY=your-compatible-key

# AI_BASE_URL overrides the selected adapter API base, INCLUDING its version path:
# Anthropic: https://api.anthropic.com/v1
# OpenAI: https://api.openai.com/v1
# Google: https://generativelanguage.googleapis.com/v1beta
# Compatible: required; include any server-specific prefix/version path.
# Only HTTP(S) is accepted. In Docker, localhost refers to the container;
# use a reachable host/service address for a local model server.

# Legacy Anthropic variables remain supported ONLY for Anthropic:
# CLAUDE_MODEL=legacy-model
# ANTHROPIC_API_URL=https://proxy.example.com
# ANTHROPIC_API_URL is an API ROOT: Dewey appends /v1 (then /messages).
# AI_BASE_URL takes precedence and does NOT receive an extra /v1.
# Native providers only read their own key. AI_API_KEY is compatible-only.
# Keys are trimmed and matching surrounding single/double quotes are removed.
# Other providers' settings are ignored, including invalid legacy URLs.
# Startup check failures are advisory; normalization may still recover later.
# Authentication errors, refusals and invalid JSON use heuristic fallback.

# =============================================================================
# PROCESSING BEHAVIOR
# =============================================================================

# DIRECTORY_STABILITY_TIMEOUT - Milliseconds to wait for directory stability before processing (default: 5000)
# Configurable to ensure larger file transfers complete before taking action
DIRECTORY_STABILITY_TIMEOUT=5000

# =============================================================================
# FILE SYSTEM PERMISSIONS
# =============================================================================

# PUID - User ID for file ownership (default: 0)
PUID=0

# PGID - Group ID for file ownership (default: 0)  
PGID=0

# FILE_MODE - Permission mode for migrated files (default: 664)
FILE_MODE=664

# DIR_MODE - Permission mode for created directories (default: 775)
DIR_MODE=775